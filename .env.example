# Postgres connection string. On Vercel use the *transaction-mode* pooled URL:
#   Supabase: Connect -> Transaction pooler (port 6543, NOT the 5432 session pooler)
#   Neon:     the "-pooler" host
DATABASE_URL=postgres://user:password@host:6543/dbname

# Optional: connections per server instance (default 1 on Vercel, 5 elsewhere).
# DB_POOL_MAX=1

# API keys are NOT configured here — add them (as many per platform as you like) on the Settings page.

# Optional: public base URL for provider callbacks. On Vercel the production domain is detected automatically.
# APP_URL=https://contact-finder.example.com
